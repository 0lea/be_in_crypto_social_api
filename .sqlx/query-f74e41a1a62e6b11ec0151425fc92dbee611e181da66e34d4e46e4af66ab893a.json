  "query": "\n        SELECT user_id, content_type, content_id, created_at\n        FROM likes\n        WHERE user_id = $1 \n          AND ($2::timestamptz IS NULL OR created_at < $2)\n        ORDER BY created_at DESC\n        LIMIT $3\n        ",
