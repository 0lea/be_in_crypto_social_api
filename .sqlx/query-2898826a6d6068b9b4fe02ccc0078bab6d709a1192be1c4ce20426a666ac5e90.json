  "query": "\n            SELECT id, user_id, content_type, content_id, created_at \n            FROM likes\n            WHERE user_id = $1\n              AND (content_type, content_id) IN (\n                SELECT * FROM UNNEST($2::text[], $3::uuid[])\n              )\n            ",
